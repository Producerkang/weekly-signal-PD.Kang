# 운영체제 파일
.DS_Store
Thumbs.db
Desktop.ini

# 편집기 설정 및 임시 파일
.vscode/
.idea/
*.swp
*.swo
*~
*.tmp
*.temp
*.bak

# 로그
*.log
logs/

# 로컬 환경변수·비밀정보
.env
.env.*
!.env.example
*.pem
*.key

# Python 보조 스크립트를 사용할 경우
__pycache__/
*.py[cod]
.venv/
venv/

# Node.js 보조 도구를 사용할 경우
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 빌드·캐시·로컬 미리보기 결과
.cache/
.parcel-cache/
dist/
build/
.tmp/
temp/

# 주간 매거진 제작 중간 산출물
drafts/
working/
preview/
*.draft.html

# 주의:
# index.html, archive/index.html, archive/YYYY-MM-DD.html은
