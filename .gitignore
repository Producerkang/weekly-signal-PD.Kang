# 운영체제 파일
.DS_Store
Thumbs.db
Desktop.ini

# 편집기 설정 및 임시 파일
.vscode/
.idea/
*.swp
*.swo
*~
*.tmp
*.temp
*.bak

# 로그
*.log
logs/

# 로컬 환경변수·비밀정보
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.secret
*.secrets
secrets/
credentials/
*.credentials.json
service-account*.json
token*.json

# 로컬 에이전트·도구 설정
.codex/
.chatgpt/
.local/
.private/

# Python 보조 스크립트를 사용할 경우
__pycache__/
*.py[cod]
.venv/
venv/

# Node.js 보조 도구를 사용할 경우
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 빌드·캐시·로컬 미리보기 결과
.cache/
.parcel-cache/
dist/
build/
.tmp/
temp/

# 주간 매거진 제작 중간 산출물
drafts/
working/
preview/
*.draft.html

# 공개 저장소에 올리지 않는 편집 메모·개인 자료
editorial/private/
editorial/local/
editorial/scratch/
*.private.md
*.local.md
*.personal.md

# 주의:
# index.html, archive/index.html, archive/YYYY-MM-DD.html은
# 실제 게시 파일이므로 무시하지 않습니다.
# .gitignore는 이미 커밋된 비밀정보를 제거하지 못합니다.
